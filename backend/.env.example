SUPPORTPILOT_DB=./data/supportpilot.db
APP_ENV=development
PRIORITY_MODEL_PATH=../severityANDpriority/priority_model.joblib
CATEGORY_MODEL_PATH=../models/category_classifier.pkl
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Shared Supabase PostgreSQL connection. Leave blank only for local SQLite development.
# Copy the connection string from Supabase Database settings. Use the Session pooler URL
# if direct database access is blocked. Keep this secret in backend/.env; never commit it.
SUPABASE_DB_URL=

# Protect this shared-secret email webhook token; do not commit backend/.env.
EMAIL_INBOUND_TOKEN=replace-with-a-long-random-secret

# Optional LibreTranslate-compatible service for English, Hindi, and Kannada answers.
# The app sends text to this endpoint only when you choose Hindi or Kannada.
TRANSLATION_URL=
TRANSLATION_API_KEY=

# Optional OpenAI-compatible Chat Completions endpoint for grounded RAG answers.
# The model receives the user's question and the top matching published articles.
# Leave blank to use source-linked article retrieval without generated answers.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
